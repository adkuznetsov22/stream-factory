# Кого пишем. Белый список — всегда в приоритете; плюс авто-поиск RU-стримов в категории игры.
LC_GAME_NAME=Grand Theft Auto VI
LC_WHITELIST=["buster","evelone2004","strogo","recrent","t2x2","skywhywalker"]
LC_AUTO_DISCOVER=true
LC_MIN_VIEWERS=5000
LC_MAX_STREAMS=8

# Детекция: чем выше порог, тем меньше и «жирнее» клипы
LC_TRIGGER_SCORE=4.0
LC_COOLDOWN=120

# Рендер. На сервере с NVIDIA: LC_VIDEO_ENCODER=h264_nvenc, LC_WHISPER_DEVICE=cuda, LC_WHISPER_COMPUTE_TYPE=float16, LC_WHISPER_MODEL=large-v3
LC_VIDEO_ENCODER=libx264
LC_WHISPER_MODEL=small
# Раскладка «вебка сверху + игра снизу»: координаты вебки в долях кадра [x, y, w, h]
# LC_LAYOUT=facecam
# LC_FACECAM={"buster":[0.0,0.0,0.22,0.3]}

# ИИ-судья (виральность, безопасность, поиск рекламы) и заголовки. Нужен один из ключей.
# LC_OPENROUTER_API_KEY=
# LC_JUDGE_MODEL=anthropic/claude-sonnet-4.6
# LC_OPENAI_API_KEY=
# LC_OPENAI_JUDGE_MODEL=gpt-4.1-mini

# Публикация. Пусто = dry-run: клипы только сохраняются в data/clips
LC_PUBLISH_TARGETS=[]
# LC_PUBLISH_TARGETS=["telegram","vk","youtube"]
# LC_TELEGRAM_BOT_TOKEN=
# LC_TELEGRAM_CHAT_ID=@my_channel
# LC_VK_ACCESS_TOKEN=
# LC_VK_GROUP_ID=
# LC_YOUTUBE_CLIENT_ID=
# LC_YOUTUBE_CLIENT_SECRET=
# LC_YOUTUBE_REFRESH_TOKEN=

# Admin panel
LC_ADMIN_PASSWORD=
LC_ADMIN_PORT=8080
